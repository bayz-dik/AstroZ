gateway:
  base_url: http://127.0.0.1:20128
  api_base: http://127.0.0.1:20129/v1
  upstream_base_url: http://127.0.0.1:20128
  hermes_api_base: ''
  # Model untuk alat `lihat` yang membaca gambar jadi teks. Isi dengan model
  # yang punya kemampuan melihat gambar, misalnya kenari-id/mimo-v2-5.
  vision_model: kenari-id/mimo-v2-5
  api_key: ''  # isi dari dashboard 9Router, atau lewat tab Model di UI
  model: kenari-id/deepseek-v4-1-flash
  fallback_models:
  - kenari-id/gemini-3-7-flash
  - kenari-id/grok-4-6
  - kenari-id/deepseek-v4-1-flash
  auto_fallback: true
  healthy:
  - oc-prod/qwen3.8-flash
  provider_name: 9router
project_dir: /root/AstroZ/workspace  # folder kerja proyek; boleh diubah dari UI
workers:
  claude:
    enabled: true
    model: ''
  codex:
    enabled: true
    model: ''
  opencode:
    enabled: true
    model: ''
  omp:
    enabled: true
    model: ''
workflow:
  max_parallel: 3
  auto_test: true
  discussion: true
  review: true
  test_command: ''
  stall_seconds: 240
  # Batas menunggu "ada socket terbuka" (lihat orchestrator.run_worker). Socket
  # terbuka hanya membuktikan pekerja menunggu sesuatu, bukan bahwa sesuatu itu
  # akan menjawab; tanpa batas ini satu port gateway mati membuat tiap pekerja
  # menunggu sampai timeout penuh.
  wait_ceiling_seconds: 600
  fix_on_fail: true
  fix_rounds: 1
  fix_review_rounds: 1
  worker_order:
  - omp
  - opencode
  - codex
  - claude
  worker_cost:
    omp: 0.01
    opencode: 0.02
    codex: 0.05
    claude: 0.45
  auto_commit: true
  # Lapis 1 dan Lapis 2 orkestrator. Pekerja paralel mengklaim berkasnya dulu,
  # yang klaimnya beririsan dikerjakan gantian, dan sesudah paralel selesai
  # berkas yang benar-benar berubah dibandingkan dengan klaim itu.
  klaim_berkas: true
  # Batas jumlah berkas per klaim: klaim sepanjang isi repo membuat semua tugas
  # beririsan dan tidak ada yang benar-benar paralel.
  batas_klaim: 12
  berkas_aman:
  - team.yaml
  - .env
  - requirements.txt
  - package.json
  - package-lock.json
  - Dockerfile
hermes:
  profile: default
  enabled: true
