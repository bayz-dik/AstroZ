gateway:
  base_url: http://127.0.0.1:20128
  api_base: http://127.0.0.1:20129/v1
  upstream_base_url: http://127.0.0.1:20128
  hermes_api_base: ''
  # Model untuk alat `lihat` yang membaca gambar jadi teks. Isi dengan model
  # yang punya kemampuan melihat gambar, misalnya kenari-id/mimo-v2-5.
  vision_model: kenari-id/mimo-v2-5
  api_key: ''  # isi dari dashboard 9Router, atau lewat tab Model di UI
  model: kenari-id/deepseek-v4-1-flash
  fallback_models:
  - kenari-id/gemini-3-7-flash
  - kenari-id/grok-4-6
  - kenari-id/deepseek-v4-1-flash
  auto_fallback: true
  healthy:
  - oc-prod/qwen3.8-flash
  provider_name: 9router
project_dir: /root/AstroZ/workspace  # folder kerja proyek; boleh diubah dari UI
workers:
  claude:
    enabled: true
    model: ''
  codex:
    enabled: true
    model: ''
  opencode:
    enabled: true
    model: ''
  omp:
    enabled: true
    model: ''
workflow:
  max_parallel: 3
  auto_test: true
  discussion: true
  review: true
  test_command: ''
  stall_seconds: 240
  fix_on_fail: true
  fix_rounds: 1
  fix_review_rounds: 1
  worker_order:
  - omp
  - opencode
  - codex
  - claude
  worker_cost:
    omp: 0.01
    opencode: 0.02
    codex: 0.05
    claude: 0.45
  auto_commit: true
hermes:
  profile: default
  enabled: true
